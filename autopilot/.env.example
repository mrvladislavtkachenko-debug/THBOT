# --- Доступ (взять на https://my.telegram.org -> API development tools) ---
API_ID=123456
API_HASH=abcdef1234567890abcdef1234567890
# Имя файла сессии (создастся сам при первом запуске после ввода телефона и кода)
SESSION_NAME=autopilot

# --- Твой канал ---
MY_CHANNEL=@your_channel
# Подпись под автопостами (можно пустую)
SIGNATURE=👉 @your_channel

# --- Каналы-доноры: откуда приводим людей комментариями (через запятую, 5-15 шт) ---
DONORS=@donor1,@donor2,@donor3
# Необязательно: комментировать ОТ ИМЕНИ своего канала (ты должен быть его админом).
# Если оставить пустым — комментарии будут от твоего личного аккаунта.
SEND_AS=@your_channel

# --- Лимиты безопасности (не увеличивай первую неделю!) ---
MAX_COMMENTS_PER_DAY=6
MAX_PER_DONOR_PER_DAY=2
COMMENT_DELAY_MIN=15
COMMENT_DELAY_MAX=45
# Часы активности (по времени сервера). Ночью не комментируем — похоже на бота
ACTIVE_HOURS_START=9
ACTIVE_HOURS_END=23
# Слова-маркеры: под такими постами НЕ комментируем (реклама, конкурсы)
STOPWORDS=реклама,розыгрыш,казино,ставк,прогноз,крипта x100,заработок без вложений

# --- Режим теста: 1 = только пишет в лог, ничего не отправляет. Для старта оставь 1! ---
DRY_RUN=1

# --- Автопостинг в свой канал ---
AUTOPOST_ENABLED=1
AUTOPOST_TIMES=09:00,13:00,19:00
POSTS_FILE=posts.txt
COMMENTS_FILE=comments.txt

# --- Статистика ---
SUBS_CHECK_HOURS=6
REPORT_TIME=09:30
DB_PATH=autopilot.db
