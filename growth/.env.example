# --- Токен бота от @BotFather ---
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# --- Твой канал (бот должен быть АДМИНОМ: посты + пригласительные ссылки) ---
CHANNEL_ID=-1001234567890
CHANNEL_URL=https://t.me/your_channel
# --- Чат обсуждений при канале, можно пустым если чата нет (бот должен быть АДМИНОМ) ---
CHAT_ID=-1001234567899
# --- Админы: свой ID через @userinfobot, несколько через запятую ---
ADMIN_IDS=123456789

# --- Автопостинг: время по серверу (Калининград = UTC+2, Москва = UTC+3) ---
AUTOPOST_TIMES=09:00,13:00,19:00
# Пересылай боту в личку любые посты (текст/фото/видео) — он сам опубликует их по расписанию
# QUIZ_TIMES — время викторин в чате, POLL_TIMES — время опросов
QUIZ_TIMES=12:00,18:00
POLL_TIMES=15:00
QUIZ_FILE=quiz.txt
POLLS_FILE=polls.txt

# --- Чат: 1 = вкл, 0 = выкл ---
WELCOME_NEW=1
CAPTCHA=1
ANTISPAM=1
# Слова через запятую — сообщения с ними удаляются
BANWORDS=казино,ставк,заработок без вложений,интим,нарко
WEEKLY_TOP=1
TOP_DAY=0
TOP_TIME=09:05

# --- Отчёт админу каждый день в это время ---
REPORT_TIME=09:30
DB_PATH=growth.db
