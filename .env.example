# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# API-ключ OpenRouter (https://openrouter.ai/keys, бесплатный)
OPENROUTER_API_KEY=

# Бесплатные модели через запятую: пробуются по порядку при сбоях/429.
# ВНИМАНИЕ: бесплатные модели OpenRouter постоянно ротируются и иногда
# отключаются — актуальный список: https://openrouter.ai/models?max_price=0
# 'openrouter/free' в конце = авто-роутер по любой живой бесплатной модели.
CLASSIFIER_MODELS=google/gemma-4-26b-a4b-it:free,qwen/qwen3-coder:free,nousresearch/hermes-3-llama-3.1-405b:free,nvidia/nemotron-3-nano-30b-a3b:free,meta-llama/llama-3.2-3b-instruct:free,openrouter/free
SYNTHESIS_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,qwen/qwen3-coder:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# Сколько постов собирать с канала (по 20 на страницу)
FETCH_POSTS_LIMIT=100
# Сколько постов в одном LLM-батче классификации
CLASSIFY_BATCH_SIZE=25
# TTL кэша отчёта в часах
CACHE_TTL_HOURS=168
# Лимит свежих анализов на пользователя в сутки (бережём лимит OpenRouter)
USER_DAILY_LIMIT=5
# Путь к файлу SQLite
DB_PATH=thbot.db
