# ============================================================
# TG Channel Analyzer — environment configuration
# Copy this file to `.env` and fill in your values.
# The `.env` file is never committed to Git.
# ============================================================

# --- Telegram Bot API (aiogram) ---
BOT_TOKEN=

# --- Telegram API / MTProto (Telethon) ---
# Used to read public channel metadata and posts.
# Obtain them at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- AI Provider ---
# Supported providers: openai | mock
# `mock` is used for local development / tests (no real AI calls).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tg_analyzer

# --- Redis (cache + job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Administration ---
# Comma-separated list of Telegram user IDs allowed to use /admin
ADMIN_IDS=

# --- Analysis behaviour ---
ANALYSIS_POST_LIMIT=100
MAX_POSTS_PER_ANALYSIS=100
ANALYSIS_CACHE_HOURS=24

# --- Rate limiting ---
FREE_ANALYSES_PER_DAY=3

# --- Job queue ---
# backend: asyncio | redis
JOB_QUEUE_BACKEND=asyncio

# --- Logging ---
LOG_LEVEL=INFO

# --- Default language ---
DEFAULT_LANGUAGE=ru

# --- Application ---
APP_NAME=TG Channel Analyzer
APP_LANGUAGE=en_US
