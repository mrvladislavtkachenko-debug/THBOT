# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# API-ключ OpenRouter (https://openrouter.ai/keys, бесплатный)
OPENROUTER_API_KEY=

# Бот САМ запрашивает актуальный список бесплатных моделей OpenRouter и берёт
# рабочие — руками ничего указывать не нужно (бесплатные модели часто отключают).
# Строки ниже — только запасной список на случай сбоя автоопределения; можно оставить как есть.
CLASSIFIER_MODELS=google/gemma-4-26b-a4b-it:free,meta-llama/llama-3.3-70b-instruct:free,openrouter/free
SYNTHESIS_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free

# Сколько постов собирать с канала (по 20 на страницу)
FETCH_POSTS_LIMIT=100
# Сколько постов в одном LLM-батче классификации
CLASSIFY_BATCH_SIZE=25
# TTL кэша отчёта в часах
CACHE_TTL_HOURS=168
# Лимит свежих анализов на пользователя в сутки (бережём лимит OpenRouter)
USER_DAILY_LIMIT=5
# Путь к файлу SQLite
DB_PATH=thbot.db
