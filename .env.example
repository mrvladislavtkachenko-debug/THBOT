# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# API-ключ OpenRouter (https://openrouter.ai/keys, бесплатный)
OPENROUTER_API_KEY=

# Бесплатные модели через запятую: пробуются по порядку при сбоях/429.
# ВНИМАНИЕ: бесплатные модели OpenRouter постоянно ротируются —
# актуальный список: https://openrouter.ai/models?max_price=0
# 'openrouter/free' в конце = авто-роутер по любой живой бесплатной модели.
CLASSIFIER_MODELS=openai/gpt-oss-20b:free,qwen/qwen3-next-80b-a3b-instruct:free,google/gemma-4-31b-it:free,openrouter/free
SYNTHESIS_MODELS=openai/gpt-oss-120b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free

# Сколько постов собирать с канала (по 20 на страницу)
FETCH_POSTS_LIMIT=100
# Сколько постов в одном LLM-батче классификации
CLASSIFY_BATCH_SIZE=25
# TTL кэша отчёта в часах
CACHE_TTL_HOURS=168
# Лимит свежих анализов на пользователя в сутки (бережём лимит OpenRouter)
USER_DAILY_LIMIT=5
# Путь к файлу SQLite
DB_PATH=thbot.db
